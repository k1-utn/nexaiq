# Browser-safe Supabase configuration. Use a publishable key, never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only values
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
NEXAIQ_ENVIRONMENT=development
NEXAIQ_MAX_ESTIMATE_BYTES=15728640
NEXAIQ_ALLOWED_ORIGINS=http://localhost:3000

# Providers are disabled unless an organization policy and server-side credential allow them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
