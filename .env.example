# Browser-safe Supabase configuration. Use a publishable key, never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only values
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
NEXAIQ_ENVIRONMENT=development
NEXAIQ_MAX_ESTIMATE_BYTES=15728640
NEXAIQ_MAX_CAPTURE_PHOTO_BYTES=8388608
NEXAIQ_MAX_CAPTURE_VOICE_BYTES=20971520
NEXAIQ_ALLOWED_ORIGINS=http://localhost:3000
NEXAIQ_AI_REQUEST_TIMEOUT_SECONDS=120
NEXAIQ_MAX_ANALYSIS_PHOTOS=8
NEXAIQ_MAX_ANALYSIS_PHOTO_BYTES=25165824
NEXAIQ_MAX_CONNECTOR_FILE_BYTES=5242880
NEXAIQ_PAID_AI_ENABLED=false

# Expo mobile receives only public values. Use your computer's LAN IP for the API URL on a phone.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=http://192.168.1.10:8001

# Providers are disabled unless an organization policy and server-side credential allow them.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
